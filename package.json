{
  "name": "arceuz-hub",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --test tests/*.test.mjs",
    "setup:users": "node --env-file=.env.local scripts/provision-users.mjs",
    "verify:setup": "node --env-file=.env.local scripts/verify-setup.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "reset:password": "node --env-file=.env.local scripts/reset-password.mjs",
    "invite": "node --env-file=.env.local scripts/issue-invite.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
